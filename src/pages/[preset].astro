---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuadletWorkbench from '../components/QuadletWorkbench.astro';
import { convertToQuadlet } from '../lib/quadlet-engine';
import { SAMPLE_TEMPLATES } from '../lib/sample-templates';
import {
	getRelatedGuideCards,
	QUADLET_CHEAT_SHEET,
	ROUTE_PRESETS,
} from '../lib/route-presets';
import type { QuadletRoutePreset } from '../lib/types';

export function getStaticPaths() {
	return ROUTE_PRESETS.filter((item) => item.slug !== '').map((item) => ({
		params: { preset: item.slug },
		props: { preset: item },
	}));
}

interface Props {
	preset: QuadletRoutePreset;
}

const { preset } = Astro.props;
const relatedCards = getRelatedGuideCards(preset.path);
const exampleTemplate = preset.showGeneratedExample
	? SAMPLE_TEMPLATES[preset.defaultTemplateId]
	: undefined;
const exampleResult = exampleTemplate
	? convertToQuadlet(exampleTemplate.content, preset.defaultOptions)
	: undefined;
const exampleOutput =
	exampleResult && exampleResult.ok
		? exampleResult.files
				.map((file) => `# === ${file.filename} (${file.installPath}) ===\n${file.content.trimEnd()}`)
				.join('\n\n')
		: '';
---

<BaseLayout
	title={preset.seoTitle}
	description={preset.metaDescription}
	canonicalPath={preset.path}
	faqs={preset.faqs}
	appName={preset.h1}
>
	<section class="mx-auto max-w-7xl px-4 pt-7 pb-3 sm:px-6 lg:px-8">
		<div class="max-w-4xl">
			<div class="flex flex-wrap items-center gap-2">
				<span class="rounded-md border border-cyan-500/35 bg-cyan-500/10 px-2.5 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-cyan-300">
					{preset.defaultInputMode === 'docker-run'
						? 'Container CLI to systemd unit preset'
						: 'Podman 4.4+ systemd unit preset'}
				</span>
				<span class="rounded-md border border-slate-800 bg-slate-900/90 px-2.5 py-1 font-mono text-xs text-slate-300">
					Scope: {preset.defaultOptions.installScope}
				</span>
			</div>
			<h1 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">
				{preset.h1}
			</h1>
			<p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">
				{preset.heroSummary}
			</p>
			{
				preset.provenanceNote && (
					<p class="mt-4 rounded-lg border border-slate-800 bg-slate-950/80 p-4 text-xs leading-relaxed text-slate-300 sm:text-sm">
						{preset.provenanceNote}
					</p>
				)
			}
			<div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
				<a
					href="#cheat-sheet"
					class="inline-flex min-h-10 items-center rounded-lg border border-slate-800 bg-slate-900/80 px-3 py-2 font-medium text-slate-200 transition-colors hover:border-cyan-500/50 hover:text-cyan-200"
				>
					Compose -&gt; Quadlet Cheat Sheet
				</a>
				<a
					href="#technical-notes-heading"
					class="inline-flex min-h-10 items-center rounded-lg border border-slate-800 bg-slate-900/80 px-3 py-2 font-medium text-slate-200 transition-colors hover:border-cyan-500/50 hover:text-cyan-200"
				>
					Technical Notes
				</a>
				<a
					href="#faq-heading"
					class="inline-flex min-h-10 items-center rounded-lg border border-slate-800 bg-slate-900/80 px-3 py-2 font-medium text-slate-200 transition-colors hover:border-cyan-500/50 hover:text-cyan-200"
				>
					Preset FAQ
				</a>
				<a
					href="#related-presets-heading"
					class="inline-flex min-h-10 items-center rounded-lg border border-slate-800 bg-slate-900/80 px-3 py-2 font-medium text-slate-200 transition-colors hover:border-cyan-500/50 hover:text-cyan-200"
				>
					Related Generators
				</a>
			</div>
		</div>
	</section>

	<QuadletWorkbench preset={preset} />

	{
		exampleTemplate && exampleOutput && (
			<section
				id="worked-example"
				aria-labelledby="worked-example-heading"
				class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8"
			>
				<div class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8">
					<p class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
						Input and output
					</p>
					<h2 id="worked-example-heading" class="mt-1.5 text-xl font-semibold text-white sm:text-2xl">
						Units this page already generated
					</h2>
					<p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-300">
						The workbench above is loaded with this input. Copy a unit or download the ZIP there. Both actions stay in the browser on quadletgen.com.
					</p>
					<div
						class:list={[
							'mt-5 grid min-w-0 gap-4',
							preset.exampleLayout === 'split' && 'lg:grid-cols-2',
						]}
					>
						<div class="min-w-0">
							<h3 class="text-sm font-semibold text-white">Compose or docker run input</h3>
							<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-4 font-mono text-xs leading-relaxed text-slate-200">{exampleTemplate.content.trimEnd()}</pre>
						</div>
						<div class="min-w-0">
							<h3 class="text-sm font-semibold text-white">Quadlet files from that input</h3>
							<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-4 font-mono text-xs leading-relaxed text-slate-200">{exampleOutput}</pre>
						</div>
					</div>
				</div>
			</section>
		)
	}

	{
		preset.guideSections && preset.guideSections.length > 0 && (
			<div class="mx-auto max-w-7xl space-y-6 px-4 py-2 sm:px-6 lg:px-8">
				{
					preset.guideSections.map((section) => (
						<section
							id={section.id}
							aria-labelledby={`${section.id}-heading`}
							class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8"
						>
							<p class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
								{section.eyebrow}
							</p>
							<h2 id={`${section.id}-heading`} class="mt-1.5 text-xl font-semibold text-white sm:text-2xl">
								{section.heading}
							</h2>
							<div class="mt-3 max-w-3xl space-y-3 text-sm leading-relaxed text-slate-300">
								{section.paragraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
							{
								section.bullets && section.bullets.length > 0 && (
									<ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-300">
										{section.bullets.map((bullet) => (
											<li>{bullet}</li>
										))}
									</ul>
								)
							}
							{
								section.codes && section.codes.length > 0 && (
									<div class="mt-5 grid min-w-0 gap-4">
										{section.codes.map((block) => (
											<div class="min-w-0">
												<h3 class="text-sm font-semibold text-white">{block.title}</h3>
												<pre class="mt-2 max-w-full overflow-x-auto rounded-lg border border-slate-800 bg-slate-950 p-4 font-mono text-xs leading-relaxed text-slate-200">{block.code}</pre>
											</div>
										))}
									</div>
								)
							}
							{
								section.links && section.links.length > 0 && (
									<ul class="mt-4 flex flex-col gap-2 text-sm">
										{section.links.map((link) => (
											<li>
												<a
													href={link.href}
													class="font-medium text-cyan-300 underline decoration-cyan-500/40 underline-offset-4 hover:text-cyan-200"
													rel={link.external ? 'noopener noreferrer' : undefined}
													target={link.external ? '_blank' : undefined}
												>
													{link.label}
												</a>
											</li>
										))}
									</ul>
								)
							}
						</section>
					))
				}
			</div>
		)
	}

	<section
		aria-labelledby="technical-notes-heading"
		class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
	>
		<div class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8">
			<h2 id="technical-notes-heading" class="text-xl font-semibold text-white sm:text-2xl">
				Technical notes for {preset.navLabel}
			</h2>
			<ul class="mt-4 grid gap-4 sm:grid-cols-2">
				{
					preset.technicalNotes.map((note, idx) => (
						<li class="min-w-0 rounded-lg border border-slate-800/90 bg-slate-950/70 p-4 text-sm leading-relaxed text-slate-300">
							<span class="mb-2 inline-block rounded border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 font-mono text-[11px] font-semibold text-cyan-300">
								0{idx + 1}
							</span>
							<p>{note}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section
		id="cheat-sheet"
		aria-labelledby="cheat-sheet-heading"
		class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8"
	>
		<div class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8">
			<div class="max-w-3xl">
				<p class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
					Syntax Mapping Reference
				</p>
				<h2 id="cheat-sheet-heading" class="mt-1.5 text-xl font-semibold text-white sm:text-2xl">
					Compose Key -&gt; Quadlet Directive Cheat Sheet
				</h2>
				<p class="mt-2 text-sm leading-relaxed text-slate-300">
					Quick lookup for how Compose YAML fields and docker or podman run flags translate into Podman systemd unit directives.
				</p>
			</div>

			<div class="mt-6 max-w-full overflow-x-auto rounded-lg border border-slate-800/90 bg-slate-950/70">
				<table class="w-full min-w-[640px] border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-slate-800 bg-slate-900/80 text-xs uppercase tracking-wider text-slate-400">
							<th scope="col" class="py-3 px-4 font-semibold">Compose Key / CLI Flag</th>
							<th scope="col" class="py-3 px-4 font-semibold">Unit Section</th>
							<th scope="col" class="py-3 px-4 font-semibold text-cyan-300">Quadlet Directive</th>
							<th scope="col" class="py-3 px-4 font-semibold">Linux systemd Behavior</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-800/80 text-slate-200">
						{
							QUADLET_CHEAT_SHEET.map((row) => (
								<tr class="hover:bg-slate-900/40">
									<th scope="row" class="py-3 px-4 font-mono text-xs font-medium text-white">
										{row.composeKey}
									</th>
									<td class="py-3 px-4 font-mono text-xs text-emerald-300">
										{row.quadletSection}
									</td>
									<td class="py-3 px-4 font-mono text-xs text-cyan-200">
										{row.quadletDirective}
									</td>
									<td class="py-3 px-4 text-xs leading-relaxed text-slate-300">
										{row.runtimeNote}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section
		aria-labelledby="faq-heading"
		class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8"
	>
		<div class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8">
			<h2 id="faq-heading" class="text-xl font-semibold text-white sm:text-2xl">
				Frequently asked questions
			</h2>
			<dl class="mt-6 divide-y divide-slate-800">
				{
					preset.faqs.map((item) => (
						<div class="py-4 first:pt-0 last:pb-0">
							<dt class="text-base font-semibold text-white">{item.question}</dt>
							<dd class="mt-2 text-sm leading-relaxed text-slate-300">{item.answer}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	{
		preset.spotlightLinks && preset.spotlightLinks.length > 0 && (
			<section
				aria-labelledby="spotlight-heading"
				class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8"
			>
				<div class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8">
					<p class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
						Continue
					</p>
					<h2 id="spotlight-heading" class="mt-1.5 text-xl font-semibold text-white sm:text-2xl">
						Related QuadletGen guides
					</h2>
					<div class="mt-5 grid gap-4 sm:grid-cols-2">
						{
							preset.spotlightLinks.map((link) => (
								<a
									href={link.href}
									class="group flex min-h-11 min-w-0 flex-col justify-between rounded-xl border border-slate-800 bg-slate-950/80 p-4 transition-colors hover:border-cyan-500/50 hover:bg-slate-900"
								>
									<div>
										<span class="inline-block rounded border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 font-mono text-[11px] font-medium text-cyan-300">
											{link.eyebrow}
										</span>
										<h3 class="mt-2.5 text-sm font-semibold text-white group-hover:text-cyan-200">
											{link.title}
										</h3>
										<p class="mt-1.5 text-xs leading-relaxed text-slate-300">{link.summary}</p>
									</div>
									<span class="mt-4 inline-flex items-center font-mono text-xs font-semibold text-cyan-300 group-hover:text-cyan-200">
										Open guide -&gt;
									</span>
								</a>
							))
						}
					</div>
				</div>
			</section>
		)
	}

	<section
		aria-labelledby="related-presets-heading"
		class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8"
	>
		<div class="min-w-0 rounded-xl border border-slate-800 bg-slate-900/60 p-5 sm:p-8">
			<p class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
				Focused Workflows
			</p>
			<h2 id="related-presets-heading" class="mt-1.5 text-xl font-semibold text-white sm:text-2xl">
				Related Podman Quadlet Generators &amp; Guides
			</h2>
			<p class="mt-2 max-w-3xl text-sm text-slate-300">
				Switch to another browser-local QuadletGen preset or read the systemd dry-run verification guide.
			</p>
			<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					relatedCards.map((card) => (
						<a
							href={card.href}
							class="group flex min-h-11 min-w-0 flex-col justify-between rounded-xl border border-slate-800 bg-slate-950/80 p-4 transition-colors hover:border-cyan-500/50 hover:bg-slate-900"
						>
							<div>
								<span class="inline-block rounded border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 font-mono text-[11px] font-medium text-cyan-300">
									{card.badge}
								</span>
								<h3 class="mt-2.5 text-sm font-semibold text-white group-hover:text-cyan-200">
									{card.title}
								</h3>
								<p class="mt-1.5 text-xs leading-relaxed text-slate-300">
									{card.summary}
								</p>
							</div>
							<span class="mt-4 inline-flex items-center font-mono text-xs font-semibold text-cyan-300 group-hover:text-cyan-200">
								{card.ctaLabel} -&gt;
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
