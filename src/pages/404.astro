---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTE_PRESETS } from '../lib/route-presets';
---

<BaseLayout
	title="Page Not Found | QuadletGen"
	description="The requested page could not be found. Choose one of the browser-local Podman Quadlet converters below."
	canonicalPath="/404/"
	noindex={true}
	showComparison={false}
>
	<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
		<div class="min-w-0 rounded-2xl border border-slate-800 bg-slate-900/75 p-6 shadow-xl sm:p-8">
			<p class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">HTTP 404</p>
			<h1 class="mt-2 text-2xl font-bold text-white sm:text-3xl">Unit route not found</h1>
			<p class="mt-3 text-sm leading-relaxed text-slate-300">
				That URL does not match an active QuadletGen preset. Pick a Podman Quadlet converter below to compile Compose YAML or container run commands locally in your browser.
			</p>

			<div class="mt-8 grid gap-3 sm:grid-cols-2">
				{
					ROUTE_PRESETS.map((route) => (
						<a
							href={route.path}
							class="group flex min-h-11 min-w-0 flex-col justify-between rounded-xl border border-slate-800 bg-slate-950/80 p-4 transition-colors hover:border-cyan-500/50 hover:bg-slate-900"
						>
							<div>
								<p class="text-sm font-semibold text-white group-hover:text-cyan-200">{route.navLabel}</p>
								<p class="mt-1 text-xs leading-relaxed text-slate-400">{route.metaDescription}</p>
							</div>
							<span class="mt-3 font-mono text-xs font-semibold text-cyan-300">
								Open generator -&gt;
							</span>
						</a>
					))
				}
			</div>

			<div class="mt-6 flex flex-wrap items-center gap-3 border-t border-slate-800 pt-5 text-xs">
				<a
					href="/"
					class="inline-flex min-h-10 items-center rounded-lg bg-cyan-400 px-4 py-2 font-semibold text-slate-950 transition-colors hover:bg-cyan-300"
				>
					Go to Compose to Quadlet Workbench
				</a>
				<a
					href="/about/"
					class="inline-flex min-h-10 items-center rounded-lg border border-slate-700 bg-slate-950 px-4 py-2 font-medium text-slate-200 transition-colors hover:border-cyan-500/50 hover:text-white"
				>
					Read Architecture &amp; Dry-Run Guide
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
